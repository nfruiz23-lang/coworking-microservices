{
  "info": {
    "_postman_id": "a9b1c2d3-e4f5-4a6b-8c7d-9e0f1a2b3c4d",
    "name": "Coworking Microservices Workshop",
    "description": "Colección de pruebas para catalog-service y orders-service (Local o Render)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Catalog Service",
      "item": [
        {
          "name": "Health Check (Catalog)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{CATALOG_URL}}/health",
              "host": ["{{CATALOG_URL}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Get All Spaces",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{CATALOG_URL}}/spaces",
              "host": ["{{CATALOG_URL}}"],
              "path": ["spaces"]
            }
          }
        },
        {
          "name": "Get Space by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{CATALOG_URL}}/spaces/1",
              "host": ["{{CATALOG_URL}}"],
              "path": ["spaces", "1"]
            }
          }
        },
        {
          "name": "Update Availability (Triggers SpaceChanged Event)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": false,\n  \"reason\": \"Mantenimiento programado de sala\"\n}"
            },
            "url": {
              "raw": "{{CATALOG_URL}}/spaces/1/availability",
              "host": ["{{CATALOG_URL}}"],
              "path": ["spaces", "1", "availability"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders Service",
      "item": [
        {
          "name": "Health Check (Orders)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ORDERS_URL}}/health",
              "host": ["{{ORDERS_URL}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Get Orders List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ORDERS_URL}}/orders",
              "host": ["{{ORDERS_URL}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Received Events Log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ORDERS_URL}}/events",
              "host": ["{{ORDERS_URL}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "Create Order (Queries Catalog)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ORDERS_URL}}/orders?space_id=1&user_email=test@example.com&hours=2",
              "host": ["{{ORDERS_URL}}"],
              "path": ["orders"],
              "query": [
                { "key": "space_id", "value": "1" },
                { "key": "user_email", "value": "test@example.com" },
                { "key": "hours", "value": "2" }
              ]
            }
          }
        }
      ]
    }
  ]
}
